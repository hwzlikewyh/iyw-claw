{
  "id": "chuangkit",
  "name": "创客贴 AI 创作",
  "env": {
    "CHUANGKIT_CLI_AUTH_MODE": "server",
    "CHUANGKIT_AGENT_HOST": "workbuddy",
    "CHUANGKIT_AGENT_SKILL_BASE_URL": "https://gw.chuangkit.com/aigc",
    "CHUANGKIT_AGENT_AUTH_BASE_URL": "https://gw.chuangkit.com/contentcopyright",
    "CHUANGKIT_CLI_CONFIG_DIR": "{{AUTH_DIR}}/.workbuddy/connectors/connector-chuangkit-config"
  },
  "packages": [
    {
      "name": "@chuangkit-labs/agent-cli",
      "spec": "@chuangkit-labs/agent-cli@0.1.3",
      "integrity": "sha512-pbdB3gwguEb0i5TmJE83Y2lHoWDTbqiHVEGbZNmotwlMfH9J7OG+r/pUYr2YArWtvDc4fbnQ6P4G0F+bldxXnw=="
    }
  ],
  "python": [],
  "install": [],
  "login": [
    {
      "command": {
        "program": "ckt-agent",
        "args": [
          "auth",
          "login"
        ]
      }
    }
  ],
  "logout": [
    {
      "program": "ckt-agent",
      "args": [
        "auth",
        "logout"
      ]
    }
  ],
  "tools": [
    {
      "name": "connector_cli",
      "description": "使用服务方官方命令行能力",
      "command": {
        "program": "ckt-agent",
        "args": []
      }
    }
  ],
  "resources": [],
  "statusMatch": "\"authenticated\": true",
  "status": {
    "program": "ckt-agent",
    "args": [
      "auth",
      "status"
    ]
  }
}
