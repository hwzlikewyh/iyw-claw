{
  "id": "mglc",
  "name": "芒果灵创 CLI",
  "env": {},
  "packages": [],
  "python": [],
  "install": [],
  "login": [
    {
      "command": {
        "program": "{{RUNTIME_DIR}}/bin/mglc.exe",
