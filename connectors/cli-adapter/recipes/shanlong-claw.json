{
  "id": "shanlong-claw",
  "name": "天财商龙餐饮SaaS",
  "env": {
    "SL_CLI_HOME": "{{AUTH_DIR}}/.slclaw",
    "SL_CONNECTOR_HOME": "{{ARTIFACT_DIR}}/vendor",
    "SL_CLI_SKIP_UPDATE": "1",
    "SL_ENV": "prod",
    "SL_MAX_SECURITY_LEVEL": "S1",
    "SL_SLY_BASEURL": "https://sly.tcsl.com.cn",
    "SL_CONNECTOR_AUTH_PAGE": "https://sly.tcsl.com.cn/login/index",
    "SL_AI_HOST": "https://aia.tcsl.com.cn",
    "SL_GATEWAY_HOST": "https://aia.tcsl.com.cn/aiproxy",
    "SL_CY7_VIA_GATEWAY": "true",
    "SL_CRM_VIA_GATEWAY": "true",
    "SL_SCM_VIA_GATEWAY": "true",
    "SL_CY7_API_BASE_URL": "https://cyfast.tcsl.com.cn/fast",
    "SL_CRM_API_BASE_URL": "https://scrm.wuuxiang.com",
    "SL_SCM_API_BASE_URL": "https://tcsl.engine.fxscm.net",
    "SL_ANALYSIS_API_BASE_URL": "https://tcsl.engine.fxscm.net",
    "SL_REPORT_API_BASE_URL": "https://cy.wuuxiang.com/cy7reportcenter/",
    "SL_DC_API_BASE_URL": "https://aia.tcsl.com.cn/aiproxy/ai2dcweb/",
    "SL_DC_VIA_GATEWAY": "false",
    "MCP_STARROCKS_URL": "https://dmp-mcp.tcsl.com.cn/mcp/workbuddy/",
    "SL_DC_MCP_ACCESS_ID": "chat-workbuddy-secret-token"
  },
  "packages": [],
  "python": [],
  "install": [
    {
      "program": "{{RUNTIME_DIR}}/bin/sl-sea.exe",
      "args": [
        "--sl-config-migrate",
        "--home",
        "{{AUTH_DIR}}/.slclaw"
      ]
    }
  ],
  "login": [
    {
      "command": {
        "program": "{{RUNTIME_DIR}}/bin/sl-sea.exe",
        "args": [
          "connector",
          "auth"
        ]
      }
    }
  ],
  "logout": [
    {
      "program": "{{RUNTIME_DIR}}/bin/sl-sea.exe",
      "args": [
        "connector",
        "unauth"
      ]
    }
  ],
  "tools": [
    {
      "name": "connector_cli",
      "description": "使用官方 CLI",
      "command": {
        "program": "{{RUNTIME_DIR}}/bin/sl-sea.exe",
        "args": []
      },
      "helpFiles": [
        "vendor/skills/member-campaign-analysis/SKILL.md",
        "vendor/skills/member-consumption-analysis/SKILL.md",
        "vendor/skills/member-coupon-analysis/SKILL.md",
        "vendor/skills/member-data-overview-analysis/SKILL.md",
        "vendor/skills/member-points-analysis/SKILL.md",
        "vendor/skills/member-profile-analysis/SKILL.md",
        "vendor/skills/member-recharge-analysis/SKILL.md",
        "vendor/skills/member-repurchase-analysis/SKILL.md",
        "vendor/skills/tcsl-company-intro/SKILL.md"
      ]
    }
  ],
