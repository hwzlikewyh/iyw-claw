{
  "id": "cnb-api",
  "name": "CNB",
  "env": {},
  "packages": [
    {
      "name": "@cnbcool/cnb-cli",
      "spec": "@cnbcool/cnb-cli@1.24.15",
      "integrity": "sha512-URVSlxRdxpF2kFmpHi99HV1yef4I4qFO1gUQKKpXjxqxdo14NO5HhIx0fUZVD10GSxE50gLDOyk5U+ibsARXHg=="
    }
  ],
  "python": [],
  "install": [],
