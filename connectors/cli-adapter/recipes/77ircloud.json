    "program": "ircloud-cli",
    "args": [
      "auth",
      "status"
    ]
  },
  "versionCheck": {
    "minimum": "1.0.2",
    "pattern": null,
    "command": {
      "program": "ircloud-cli",
      "args": [
        "version"
      ]
    }
