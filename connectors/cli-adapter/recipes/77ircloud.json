{
  "id": "77ircloud",
  "name": "铱云AI供应链",
  "env": {},
  "packages": [
    {
      "name": "@ircloud/cli-workbuddy",
      "spec": "{{ARTIFACT_DIR}}/vendor/cli-package.tgz"
    }
  ],
  "python": [],
  "install": [],
  "login": [
    {
      "command": {
        "program": "ircloud-cli",
        "args": [
          "auth",
          "login"
        ]
      }
    }
  ],
  "logout": [
    {
      "program": "ircloud-cli",
      "args": [
        "auth",
        "logout"
      ]
    }
  ],
  "tools": [
    {
      "name": "connector_cli",
      "description": "使用服务方官方命令行能力",
      "command": {
        "program": "ircloud-cli",
        "args": []
      }
    }
  ],
  "resources": [
    {
      "source": "assets/77ircloud/package.tgz",
      "path": "vendor/cli-package.tgz",
      "sha256": "56ef6d208ad5a4a804941f802c62a8f72c7b79d49f76fb10f0078746827e43b6"
    }
  ],
  "statusMatch": "已登录",
