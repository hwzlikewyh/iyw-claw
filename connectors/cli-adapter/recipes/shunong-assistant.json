{
  "id": "shunong-assistant",
  "name": "数字农人",
  "env": {
    "SHUNONG_GATEWAY_URL": "https://agent-gateway.gc365.com",
    "SHUNONG_AUTH_ORIGIN": "https://shunong.gc365.com"
  },
  "packages": [
    {
      "name": "sznr-cli",
      "spec": "sznr-cli@0.1.2",
      "integrity": "sha512-uABRruMF/DYDX/0QjbXI1Nhpqpf3Z/Vjjs0vdSannwTP3M2IOqfPf1u8L8hXDfnjqTYqv5TREqPT++sIQt2nKw=="
    }
  ],
  "python": [],
  "install": [],
  "login": [
    {
      "command": {
        "program": "sznr-cli",
        "args": [
          "auth",
          "login"
        ]
      }
    }
  ],
  "logout": [
    {
      "program": "sznr-cli",
      "args": [
        "auth",
        "logout"
      ]
    }
  ],
  "tools": [
    {
      "name": "connector_cli",
      "description": "使用服务方官方命令行能力",
      "command": {
        "program": "sznr-cli",
        "args": []
      }
    }
  ],
  "resources": [],
  "statusMatchJson": {
    "loggedIn": "true"
  },
  "status": {
    "program": "sznr-cli",
    "args": [
      "auth",
      "status"
    ]
  },
  "versionCheck": {
    "minimum": "0.1.2",
    "pattern": "(\\d+\\.\\d+\\.\\d+)",
    "command": {
      "program": "sznr-cli",
      "args": [
        "--version"
      ]
    }
  }
}
