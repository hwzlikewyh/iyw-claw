{
  "id": "ailit",
  "name": "智慧记AI进销存",
  "env": {
    "CLIENT_INFO_PRODUCT_NAME": "WorkBuddy"
  },
  "packages": [
    {
      "name": "@co-ailit/ailit-cli",
      "spec": "@co-ailit/ailit-cli@0.8.3",
      "integrity": "sha512-frn1oIjLzUnRPZgTXymZknn++vlDZvw5sQzP7ZWxyUIMO7Gno88CaPMe2jszRk+8G1BlA+WFZZLWADUB5evhog=="
    }
  ],
  "python": [],
  "install": [],
  "login": [
    {
      "command": {
        "program": "ailit",
        "args": [
          "auth",
          "login",
          "--timeout",
          "3m"
        ]
      }
    }
  ],
  "logout": [
    {
      "program": "ailit",
      "args": [
        "auth",
        "logout"
      ]
    }
  ],
  "tools": [
    {
      "name": "connector_cli",
      "description": "使用服务方官方命令行能力",
      "command": {
        "program": "ailit",
        "args": []
      }
    }
  ],
  "resources": [],
  "statusMatch": "corpToken:\\s+yes",
  "status": {
    "program": "ailit",
    "args": [
      "auth",
      "status",
      "--format",
      "pretty"
    ]
  },
  "versionCheck": {
    "minimum": "0.8.3",
    "pattern": null,
    "command": {
      "program": "ailit",
      "args": [
        "--version"
      ]
    }
  }
}
