# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
tsconfig.tsbuildinfo

# Next.js
.next/
out/
next-env.d.ts

# Monaco editor local files (copied from node_modules)
public/vs

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test artifacts
coverage/
*.snap.new
.vitest-cache/

# macOS signing material. Keep certificates and exported private keys out of git.
*.cer
*.csr
*.p12
certificate-base64.txt

# Agent
.claude
.docs
docs/superpowers
.codegraph/

# Tauri sidecar staging (built per-target by prepare-sidecars.mjs).
# The binaries are platform-specific build artifacts; ship them through
# release.yml, not git.
src-tauri/binaries/

# Bundled runtime archives (downloaded/built by prepare-sidecars.mjs).
# Large binary artifacts staged for inclusion in the installer; not tracked in git.
# The parent directory resources/runtime/ itself IS tracked (with a placeholder) so
# the Tauri build never errors on a missing resource path.
src-tauri/resources/runtime/downloads/
src-tauri/resources/runtime/npm/

# Platform-specific bundled runtime seed generated immediately before Tauri build.
src-tauri/resources/runtime-seed/
src-tauri/resources/runtime-seed-staging-*/
.runtime-seed-cache/
src-tauri/tauri.runtime-seed.conf.json

# Experimental Codex worker library staged only by the opt-in preparation script.
src-tauri/resources/codex-worker/

# pnpm local store (pnpm 11+)
.pnpm-store/

# Python skill script bytecode (generated at runtime, never committed).
__pycache__/
*.pyc
