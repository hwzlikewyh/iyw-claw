{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "canvasId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "displayMode": {
      "enum": [
        "inline",
        "fullscreen"
      ]
    }
  },
  "additionalProperties": false
}
