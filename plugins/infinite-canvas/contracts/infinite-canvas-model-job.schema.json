{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "operation": {
      "enum": [
        "read",
        "status",
        "complete",
        "fail",
        "cancel"
      ]
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "response": {
      "type": "object",
      "additionalProperties": true
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "mimeType": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          }
        },
        "required": [
          "sourcePath",
          "mimeType"
        ],
        "additionalProperties": false
      }
    },
    "error": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "operation",
    "requestId"
  ],
  "additionalProperties": false
}
