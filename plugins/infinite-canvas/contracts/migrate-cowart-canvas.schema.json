      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "targetCanvasId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "dryRun": {
      "type": "boolean"
    }
  },
  "required": [
